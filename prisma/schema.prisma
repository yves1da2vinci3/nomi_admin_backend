generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer, transaction mode) for the running app.
  url       = env("DATABASE_URL")
  // Direct connection for `prisma migrate`/introspection — MUST bypass the
  // pooler (PgBouncer transaction mode breaks migrations). Falls back to
  // DATABASE_URL when unset so local/dev without a pooler still works.
  directUrl = env("DIRECT_URL")
}

enum LexicalBand {
  foundational
  developing
  refined
}

enum VocabularySource {
  acquired
  discovered
  manual
  diary
  listening
  interpreter
  dictionary
}

model User {
  id                        String                     @id @default(uuid())
  email                     String                     @unique
  uid                       String                     @unique
  displayName               String?
  photoURL                  String?
  isSuspended               Boolean                    @default(false)
  level                     String?
  expoPushToken             String?
  webPushSubscription       Json?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  learningLanguage          String?
  learningLanguages         String[]
  nativeLanguage            String?
  learnedWords              LearnedWord[]
  scenarioSessions          ScenarioSession[]
  interpreterSessions       InterpreterSession[]
  interpreterPractices      InterpreterPractice[]
  interpreterPracticeRuns   InterpreterPracticeRun[]
  userProgress              UserProgress?
  userLanguageLexicalStages UserLanguageLexicalStage[]
  storyPlays                StoryPlay[]
  gamePlays                 GamePlay[]
  companyLearners           CompanyLearner[]
}

model UserLanguageLexicalStage {
  id                        String      @id @default(uuid())
  userId                    String
  languageCode              String
  lexicalStage              LexicalBand @default(foundational)
  lastPromotedAt            DateTime?
  pendingLexicalCelebration Json?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  user                      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode])
  @@index([userId])
}

model Scenario {
  id             String               @id @default(uuid())
  title          Json
  description    Json
  pnjRole        String
  pnjPersonality String
  pnjTone        String
  location       String
  theme          String
  imageUrl       String?
  pnjImageUrl    String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  goals          ScenarioGoal[]
  sessions       ScenarioSession[]
  vocabulary     ScenarioVocabulary[]
}

model ScenarioGoal {
  id              String   @id @default(uuid())
  scenarioId      String
  title           Json
  description     Json
  order           Int
  expectedWords   Json
  expectedPhrases Json
  minWords        Int      @default(1)
  requiredWords   Json
  optionalWords   Json
  successMessage  Json
  failureMessage  Json
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  scenario        Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model ScenarioVocabulary {
  id          String   @id @default(uuid())
  scenarioId  String
  word        String
  translation Json
  category    String
  difficulty  Int      @default(1)
  context     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model ScenarioSession {
  id                  String               @id @default(uuid())
  userId              String
  scenarioId          String
  learningLanguage    String
  nativeLanguage      String
  difficulty          String
  status              String               @default("active")
  currentStep         Int                  @default(0)
  totalSteps          Int
  score               Int                  @default(0)
  duration            Int                  @default(0)
  learnedWords        String[]
  completed           Boolean              @default(false)
  startedAt           DateTime             @default(now())
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  messages            ChatMessage[]
  corrections         GECCorrection[]
  scenario            Scenario             @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnedWordSessions LearnedWordSession[]

  @@index([userId, scenarioId, status])
}

model ChatMessage {
  id             String          @id @default(uuid())
  sessionId      String
  type           String
  content        String
  confidence     Float?
  step           Int
  timestamp      DateTime        @default(now())
  createdAt      DateTime        @default(now())
  audioUrl       String?
  audioFileUrl   String?
  transcription  String?
  wordTimestamps Json?
  inputMode      String?
  session        ScenarioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  corrections    GECCorrection[]
}

model GECCorrection {
  id          String          @id @default(uuid())
  sessionId   String
  messageId   String
  step        Int
  wrong       String
  correction  String
  reason      String?
  errorType   String?
  confidence  Float?
  severity    Float           @default(0.0)
  createdAt   DateTime        @default(now())
  userMessage ChatMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  session     ScenarioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model LearnedWord {
  id                      String               @id @default(uuid())
  userId                  String
  word                    String
  language                String
  context                 String?
  difficulty              Int                  @default(1)
  lexicalBand             LexicalBand          @default(foundational)
  timesUsed               Int                  @default(0)
  timesCorrect            Int                  @default(0)
  lastUsed                DateTime             @default(now())
  masteryLevel            Float                @default(0.0)
  status                  String               @default("active")
  isFavorite              Boolean              @default(false)
  vocabularySource        VocabularySource     @default(acquired)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnedWordSessions     LearnedWordSession[]
  phraseExamples          Json?
  phraseExamplesExpiresAt DateTime?

  @@unique([userId, language, word])
}

model LearnedWordSession {
  id                String          @id @default(uuid())
  learnedWordId     String
  scenarioSessionId String
  createdAt         DateTime        @default(now())
  learnedWord       LearnedWord     @relation(fields: [learnedWordId], references: [id], onDelete: Cascade)
  scenarioSession   ScenarioSession @relation(fields: [scenarioSessionId], references: [id], onDelete: Cascade)

  @@unique([learnedWordId, scenarioSessionId])
  @@index([scenarioSessionId])
}

model UserProgress {
  id                String    @id @default(uuid())
  userId            String    @unique
  totalSessions     Int       @default(0)
  completedSessions Int       @default(0)
  totalScore        Int       @default(0)
  averageScore      Float     @default(0.0)
  totalTimeSpent    Int       @default(0)
  wordsLearned      Int       @default(0)
  lastPlayed        DateTime?
  bestScore         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeneratedGame {
  id               String      @id @default(uuid())
  userId           String
  gameType         String
  status           String      @default("pending")
  difficulty       String
  learningLanguage String
  userLanguage     String
  scenarioIds      String[]
  words            String[]
  gameData         Json?
  error            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  plays            StoryPlay[]
  gamePlays        GamePlay[]

  @@index([userId, status])
}

model StoryPlay {
  id          String    @id @default(uuid())
  userId      String
  gameId      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  score       Int?
  durationSec Int?

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game GeneratedGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, completedAt])
  @@index([gameId])
}

model GamePlay {
  id          String   @id @default(uuid())
  userId      String
  gameId      String
  gameType    String
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())
  durationSec Int
  score       Int?

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game GeneratedGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameType])
  @@index([userId, completedAt])
  @@index([gameId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model InterpreterScenario {
  id               String                 @id @default(uuid())
  slug             String?                @unique
  title            Json
  description      Json
  listingTeaser    Json?
  location         Json
  difficulty       String
  estimatedMinutes Int                    @default(8)
  imageKey         String?
  theme            String?
  sessionTones     Json?
  promptContext    Json?
  speakers         Json?
  interactionType  String? // legacy: 'single_pnj' or 'multi_pnj'
  pnjs             Json? // legacy: Array of { name, role, personality, avatarUrl }
  imageUrl         String?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  objectives       InterpreterObjective[]
  sessions         InterpreterSession[]
  practices        InterpreterPractice[]

  @@index([difficulty, isActive])
  @@index([theme, isActive])
  @@index([slug])
}

model InterpreterPractice {
  id               String    @id @default(uuid())
  userId           String
  scenarioId       String
  scenarioSlug     String
  status           String    @default("pending")
  turnCount        Int
  config           Json
  resolvedSpeakers Json
  generatedTurns   Json?
  playCount        Int       @default(0)
  errorMessage     String?
  readyAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario InterpreterScenario      @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  runs     InterpreterPracticeRun[]

  @@index([userId, status])
  @@index([scenarioSlug])
}

model InterpreterPracticeRun {
  id           String    @id @default(uuid())
  practiceId   String
  userId       String
  status       String    @default("active")
  coreJobId    String?
  feedback     Json?
  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  practice InterpreterPractice             @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  user     User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments InterpreterPracticeRunSegment[]

  @@index([userId, status])
  @@index([practiceId])
}

model InterpreterPracticeRunSegment {
  id             String  @id @default(uuid())
  runId          String
  segmentId      String
  roundIndex     Int
  segmentInRound Int
  activePnjId    String
  pnjSpeech      String
  objectiveTitle String
  objectiveHint  String
  targetLanguage String
  userTranscript String?
  sttStatus      String  @default("pending")
  scores         Json?

  run InterpreterPracticeRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, segmentId])
  @@index([runId])
}

model InterpreterObjective {
  id          String              @id @default(uuid())
  scenarioId  String
  title       Json
  description Json
  order       Int
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  scenario    InterpreterScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId, order])
}

model InterpreterSession {
  id                  String                  @id @default(uuid())
  userId              String
  scenarioId          String
  learningLanguage    String
  nativeLanguage      String
  status              String                  @default("active")
  totalObjectives     Int
  scoresPerObjective  Json? // { objectiveId: { understanding, accuracy, efficiency, translation, score } }
  audioUrls           Json? // { objectiveId: { pnjAudioUrl, userAudioUrl } }
  llmEval             Json? // LLM evaluation results
  vocabularySpotlight Json? // Extracted words/expressions
  feedback            Json? // Final feedback with dimensions
  completed           Boolean                 @default(false)
  startedAt           DateTime                @default(now())
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  scenario            InterpreterScenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages            InterpretationMessage[]

  @@index([userId, scenarioId, status])
  @@index([status, completed])
}

model InterpreterAssistanceCache {
  id               String   @id @default(cuid())
  scenarioId       String
  speechHash       String
  learningLanguage String
  nativeLanguage   String
  difficulty       String
  keywords         Json
  structure        String
  starter          String
  fullSuggestion   String
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([scenarioId, speechHash, learningLanguage, nativeLanguage, difficulty])
  @@index([scenarioId, learningLanguage, nativeLanguage, difficulty])
}

model ScenarioKeywordsHintsCache {
  id               String   @id @default(cuid())
  scenarioId       String
  goalId           String
  learningLanguage String
  nativeLanguage   String
  difficulty       String
  keywords         Json
  hints            Json
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([scenarioId, goalId, learningLanguage, nativeLanguage, difficulty])
  @@index([scenarioId, learningLanguage, nativeLanguage])
}

model InterpretationMessage {
  id             String             @id @default(uuid())
  sessionId      String
  type           String // 'pnj' or 'user'
  speaker        String // pnjId or userId
  content        String // transcript
  audioUrl       String?
  objectiveId    String?
  step           Int
  wordTimestamps Json?
  timestamp      DateTime           @default(now())
  createdAt      DateTime           @default(now())
  session        InterpreterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, step])
  @@index([sessionId, objectiveId])
}

/**
 * Compte staff pour futur login admin API (admin_backend) — distinct du User app.
 */
model Admin {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  displayName    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studioProjects StudioProject[]
}

model StudioProject {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title     String   @default("")
  state     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
}

// Externally managed by the diary service. Declared here so Prisma Migrate
// preserves the table reconciled by 20260509094500_reconcile_external_tables.
model ExternalDiaryEntry {
  id                  String   @id @db.Uuid
  status              String   @default("pending")
  audioPath           String   @map("audio_path")
  durationMs          Int?     @map("duration_ms")
  rawText             String?  @map("raw_text")
  correctedText       String?  @map("corrected_text")
  expectedIpa         String?  @map("expected_ipa")
  detectedTheme       String?  @map("detected_theme")
  themeKeywords       Json?    @map("theme_keywords")
  words               Json?
  analysis            Json?
  diff                Json?
  responseText        String?  @map("response_text")
  responseAudioPath   String?  @map("response_audio_path")
  error               String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  language            String?
  userId              String?  @map("user_id")
  nativeLanguage      String?  @map("native_language")
  responseTranslation String?  @map("response_translation")
  audioUrl            String?  @map("audio_url")

  @@index([createdAt(sort: Desc)], map: "idx_diary_entries_created_at")
  @@index([language], map: "idx_diary_entries_language")
  @@index([status], map: "idx_diary_entries_status")
  @@index([userId, createdAt(sort: Desc)], map: "idx_diary_entries_user_id")
  @@map("diary_entries")
}

// Migration ledger owned by the external diary service.
model ExternalSchemaMigration {
  version BigInt  @id
  dirty   Boolean

  @@map("schema_migrations")
}

// ---------------------------------------------------------------------------
// B2B — entreprises, cohortes, apprenants, modules, licences.
// Consommé par admin_backend (admin interne + portail partenaire b2b-admin).
// ---------------------------------------------------------------------------

enum CompanyOrgType {
  training_center
  school
  enterprise
}

enum CompanyPlan {
  pilot
  center
  school
  enterprise
}

enum PortalRole {
  org_admin
  instructor
  viewer
}

enum PartnerUserStatus {
  active
  pending
}

enum CohortStatus {
  upcoming
  active
  ended
  archived
}

enum LearnerStatus {
  active
  inactive
  never
}

enum B2bAssignmentStatus {
  active
  overdue
  completed
  cancelled
}

enum AssignmentProgressStatus {
  done
  pending
  late
}

enum PackTier {
  base
  addon
  boost
}

enum PackBillingPeriod {
  monthly
  quarterly
  one_time
}

enum PackBadge {
  popular
  included_in_plan
  new
}

enum EntitlementStatus {
  active
  expired
  pending
}

enum PurchaseStatus {
  pending
  paid
  failed
  refunded
}

enum PurchaseCurrency {
  XOF
  USD
}

enum CertificateStatus {
  draft
  issued
  revoked
}

enum LearningPathStatus {
  draft
  active
  completed
}

enum ReportFormat {
  pdf
  csv
}

enum NudgeChannel {
  email
  digest
}

/**
 * Entreprise / centre de formation cliente. `seatsUsed` n'est pas stocké :
 * il se calcule par `_count` sur `CompanyLearner`.
 */
model Company {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  orgType       CompanyOrgType @default(training_center)
  plan          CompanyPlan    @default(pilot)
  seatLimit     Int            @default(0)
  apiQuotaMonth Int            @default(0)
  apiUsedMonth  Int            @default(0)
  logoUrl       String?
  timezone      String         @default("UTC")
  renewalDate   DateTime?
  weeklyDigest  Boolean        @default(true)
  quotaAlert    Boolean        @default(true)
  monthlyReport Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  partnerUsers   PartnerUser[]
  cohorts        Cohort[]
  learners       CompanyLearner[]
  assignments    B2bAssignment[]
  entitlements   CompanyEntitlement[]
  purchaseOrders PurchaseOrder[]
  usageEvents    ModuleUsageEvent[]
  certificates   CompanyCertificate[]
  learningPaths  LearningPath[]
  nudgeLogs      NudgeLog[]
  reports        CompanyReport[]

  @@index([isActive])
}

/**
 * Utilisateur du portail b2b-admin — distinct de `Admin` (staff interne)
 * et de `User` (app mobile).
 */
model PartnerUser {
  id           String            @id @default(uuid())
  companyId    String
  email        String            @unique
  passwordHash String?
  displayName  String?
  portalRole   PortalRole        @default(viewer)
  status       PartnerUserStatus @default(pending)
  lastLoginAt  DateTime?
  invitedAt    DateTime          @default(now())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cohortInstructors  CohortInstructor[]
  createdAssignments B2bAssignment[]
  sentNudges         NudgeLog[]

  @@index([companyId, status])
}

model Cohort {
  id         String       @id @default(uuid())
  companyId  String
  name       String
  inviteCode String       @unique
  startDate  DateTime
  endDate    DateTime
  seatLimit  Int          @default(0)
  status     CohortStatus @default(upcoming)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  learners            CompanyLearner[]
  instructors         CohortInstructor[]
  assignmentCohorts   AssignmentCohort[]
  learningPathCohorts LearningPathCohort[]

  @@index([companyId, status])
}

model CohortInstructor {
  id            String   @id @default(uuid())
  cohortId      String
  partnerUserId String
  createdAt     DateTime @default(now())

  cohort      Cohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  partnerUser PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)

  @@unique([cohortId, partnerUserId])
  @@index([partnerUserId])
}

/**
 * Apprenant rattaché à une entreprise. `userId` reste null tant que la personne
 * n'a pas créé son compte app Nomi (invitation par email / code cohorte).
 */
model CompanyLearner {
  id             String        @id @default(uuid())
  companyId      String
  cohortId       String
  userId         String?
  email          String
  name           String
  cefrLevel      String?
  status         LearnerStatus @default(never)
  invitedAt      DateTime      @default(now())
  enrolledAt     DateTime?
  lastActivityAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  assignmentProgress AssignmentProgress[]
  certificates       CompanyCertificate[]
  usageEvents        ModuleUsageEvent[]

  @@unique([companyId, email])
  @@unique([companyId, userId])
  @@index([cohortId, status])
  @@index([userId])
}

/**
 * Module produit activable (table éditable depuis `admin/`).
 * `key` correspond aux domaines existants : scenario, diary, interpreter,
 * listening_story, review_game.
 */
model B2bModule {
  id        String   @id @default(uuid())
  key       String   @unique
  name      Json
  icon      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packItems          ModulePackItem[]
  entitlementCredits EntitlementCredit[]
  assignments        B2bAssignment[]
  usageEvents        ModuleUsageEvent[]
  learningPathWeeks  LearningPathWeek[]

  @@index([isActive, sortOrder])
}

model ModulePack {
  id            String            @id @default(uuid())
  slug          String            @unique
  name          String
  tagline       String?
  tier          PackTier          @default(addon)
  billingPeriod PackBillingPeriod @default(monthly)
  priceFcfa     Int               @default(0)
  priceUsdCents Int               @default(0)
  badge         PackBadge?
  features      String[]
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  items          ModulePackItem[]
  entitlements   CompanyEntitlement[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive, tier])
}

model ModulePackItem {
  id             String @id @default(uuid())
  packId         String
  moduleId       String
  sessionCredits Int    @default(0)

  pack   ModulePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  module B2bModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([packId, moduleId])
  @@index([moduleId])
}

model CompanyEntitlement {
  id          String            @id @default(uuid())
  companyId   String
  packId      String
  status      EntitlementStatus @default(pending)
  purchasedAt DateTime          @default(now())
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pack    ModulePack          @relation(fields: [packId], references: [id], onDelete: Cascade)
  credits EntitlementCredit[]

  @@index([companyId, status])
  @@index([packId])
}

model EntitlementCredit {
  id               String @id @default(uuid())
  entitlementId    String
  moduleId         String
  creditsRemaining Int    @default(0)

  entitlement CompanyEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  module      B2bModule          @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([entitlementId, moduleId])
  @@index([moduleId])
}

model PurchaseOrder {
  id              String           @id @default(uuid())
  companyId       String
  packId          String
  amountFcfa      Int
  currency        PurchaseCurrency @default(XOF)
  status          PurchaseStatus   @default(pending)
  stripeSessionId String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pack    ModulePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

/**
 * Journal de consommation de crédits. `[sourceType, sourceId]` unique rend
 * le décrément idempotent (rejeu de webhook / worker sans double débit).
 */
model ModuleUsageEvent {
  id              String   @id @default(uuid())
  companyId       String
  learnerId       String?
  moduleId        String
  sourceType      String
  sourceId        String
  creditsConsumed Int      @default(1)
  occurredAt      DateTime @default(now())

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  learner CompanyLearner? @relation(fields: [learnerId], references: [id], onDelete: SetNull)
  module  B2bModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([companyId, moduleId, occurredAt])
  @@index([learnerId])
}

/**
 * Devoir assigné à une ou plusieurs cohortes. `targetsAllCohorts` remplace la
 * sentinelle « tableau de cohortes vide = toutes » du prototype.
 */
model B2bAssignment {
  id                     String              @id @default(uuid())
  companyId              String
  moduleId               String
  title                  String
  deadline               DateTime
  message                String?
  contentType            String?
  contentId              String?
  status                 B2bAssignmentStatus @default(active)
  targetsAllCohorts      Boolean             @default(false)
  createdByPartnerUserId String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module               B2bModule            @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  createdByPartnerUser PartnerUser?         @relation(fields: [createdByPartnerUserId], references: [id], onDelete: SetNull)
  cohorts              AssignmentCohort[]
  progress             AssignmentProgress[]

  @@index([companyId, status])
  @@index([moduleId])
}

model AssignmentCohort {
  id           String @id @default(uuid())
  assignmentId String
  cohortId     String

  assignment B2bAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  cohort     Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, cohortId])
  @@index([cohortId])
}

model AssignmentProgress {
  id           String                   @id @default(uuid())
  assignmentId String
  learnerId    String
  status       AssignmentProgressStatus @default(pending)
  submittedAt  DateTime?
  score        Int?
  updatedAt    DateTime                 @updatedAt

  assignment B2bAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  learner    CompanyLearner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, learnerId])
  @@index([learnerId, status])
}

/**
 * Certificat = snapshot au moment de l'émission (noms et scores figés).
 * `cohortId` est volontairement sans clé étrangère.
 */
model CompanyCertificate {
  id             String            @id @default(uuid())
  companyId      String
  learnerId      String
  cohortId       String?
  learnerName    String
  cohortName     String?
  companyName    String
  issuedAt       DateTime          @default(now())
  issuedBy       String
  averageScore   Float             @default(0)
  totalSessions  Int               @default(0)
  totalHours     String?
  cefrLevel      String?
  scoresByModule Json
  status         CertificateStatus @default(issued)
  revokedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  learner CompanyLearner @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([learnerId])
}

model LearningPath {
  id          String             @id @default(uuid())
  companyId   String
  name        String
  description String?
  status      LearningPathStatus @default(draft)
  activatedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  weeks   LearningPathWeek[]
  cohorts LearningPathCohort[]

  @@index([companyId, status])
}

model LearningPathWeek {
  id                 String  @id @default(uuid())
  pathId             String
  week               Int
  moduleId           String
  assignmentTitle    String
  deadlineOffsetDays Int     @default(7)
  description        String?

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  module B2bModule    @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([pathId, week])
  @@index([moduleId])
}

model LearningPathCohort {
  id       String @id @default(uuid())
  pathId   String
  cohortId String

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  cohort Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([pathId, cohortId])
  @@index([cohortId])
}

model NudgeLog {
  id                  String       @id @default(uuid())
  companyId           String
  learnerIds          String[]
  channel             NudgeChannel @default(email)
  message             String
  sentByPartnerUserId String?
  sentAt              DateTime     @default(now())

  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sentByPartnerUser PartnerUser? @relation(fields: [sentByPartnerUserId], references: [id], onDelete: SetNull)

  @@index([companyId, sentAt])
}

model CompanyReport {
  id          String       @id @default(uuid())
  companyId   String
  type        String
  format      ReportFormat @default(pdf)
  author      String?
  cohortId    String?
  cohortName  String?
  periodStart DateTime?
  periodEnd   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}
