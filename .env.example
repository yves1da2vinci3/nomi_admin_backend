DATABASE_URL="postgresql://user:pass@localhost:5433/nomi"
ADMIN_API_TOKEN="change-me-long-random"
# Optional: UUID of an Admin row — when using Bearer ADMIN_API_TOKEN, sets req.adminAuth.sub (needed for /studio/projects etc.)
# ADMIN_API_ACTING_SUB=""
# ADMIN_API_ACTING_EMAIL="api-token@local.invalid"
JWT_SECRET="minimum-sixteen-chars-change-in-production"
JWT_EXPIRES_IN="8h"
PORT=4001
ADMIN_CORS_ORIGIN="http://localhost:8080"

# --- Portail B2B (b2b-admin) ---
# Origine du portail partenaire autorisée en CORS
PARTNER_CORS_ORIGIN="http://localhost:3000"
# Durée de vie du JWT PartnerUser
PARTNER_JWT_EXPIRES_IN="12h"
# URL publique du portail — base des redirections Stripe (success/cancel)
B2B_PORTAL_URL="http://localhost:3000"

# Stripe — sans STRIPE_SECRET_KEY, le checkout des packs passe en mode simulation
# (commande créée, entitlement accordé à la confirmation explicite).
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."   # requis pour POST /api/v1/partner/stripe/webhook

# Balayage d'usage B2B (crédits, activité apprenants, devoirs) — 0 désactive l'ordonnanceur
USAGE_INGEST_INTERVAL_MS=300000

# nomi-core (voice/diary) — used by GET /users/:id/detail for diary stats
NOMI_CORE_URL="http://localhost:8088"

# Redis — same instance as nomi_backend, used read-only for /ops/queues job counts
# REDIS_URL="redis://localhost:6379"

# Optional — enables real Expo push send in POST /notifications/test-push (falls back to DB-only insert if unset)
# EXPO_ACCESS_TOKEN=""

# Optional — without it, /studio/ai/* returns 503 (other routes still work)
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Backblaze B2 — uploads admin (/api/v1/upload). Either set B2_DOWNLOAD_URL or reuse BACKBLAZE_BUCKET_URL (same as nomi_backend).
# B2_KEY_ID=""
# B2_APPLICATION_KEY=""
# B2_BUCKET_ID=""
# B2_BUCKET_NAME=nomiBucket
# B2_DOWNLOAD_URL="https://fXXX.backblazeb2.com"
# BACKBLAZE_BUCKET_URL="https://fXXX.backblazeb2.com"

# Seed (scripts/seed-admin.ts)
SEED_ADMIN_EMAIL="admin@nomi.local"
SEED_ADMIN_PASSWORD="changeme"

# Seed B2B (scripts/seed-b2b.ts) — modules, packs, entreprise de démo, org_admin du portail
SEED_B2B_COMPANY_SLUG="binne"
SEED_B2B_PARTNER_EMAIL="marie@binne.ci"
SEED_B2B_PARTNER_PASSWORD="changeme123"
